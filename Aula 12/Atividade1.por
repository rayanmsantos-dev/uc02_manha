programa {
  funcao inicio() {


    //a) Declaração: real precoLitro, litros, total
    //   Entrada: Leia precoLitro, litros, total
    //   Processamento: total = precoLitro * litros
    //   Saída: ("Total a pagar: R$ ", total, "\n")
    //b) Sim, está tudo correto.

    //Declaração
     real precoLitro, litros, total
     //Entrada
        escreva("Preço do litro da gasolina em Maceió: ")
        leia(precoLitro)
        escreva("Quantos litros abasteceu: ")
        leia(litros)
        //Procesamento
        total = precoLitro * litros
        //Saída
        escreva("Total a pagar: R$ ", total, "\n")

  }
}
