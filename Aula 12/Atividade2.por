programa {
  funcao inicio() {
    real altura, base, resultado
      escreva("===Cálculo da área de um triângulo=== \n")
      escreva("Informe a altura: ") 
      leia(altura)
      escreva("Informe a base: ") 
      leia(base)
      resultado = (altura * base) / 2
      escreva("O resultado da área do triângulo é igual: ", resultado, "m². \n")
  }
}
