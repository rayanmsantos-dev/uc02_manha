programa {
  funcao inicio() {
    real numero1, numero2, calculo1, calculo2, calculo3, calculo4
    escreva("escreva as equações que você deseja realizar: ")
    leia(numero1)
    leia(numero2)
    calculo1 = numero1 + numero2
    calculo2 = numero1 - numero2
    calculo3 = numero1 * numero2
    calculo4 = numero1 / numero2
    escreva("O total é deste equação é de: : ", calculo1, "\n")
    escreva("O total é deste equação é de: : ", calculo1, "\n")
    escreva("O total é deste equação é de: : ", calculo3, "\n")
    escreva("O total é deste equação é de: : ", calculo4, "\n")
    
    
